TLAMATINI_AI_HOST=127.0.0.1
TLAMATINI_AI_TIMEOUT=90
TLAMATINI_AI_CONTEXT=3072
TLAMATINI_AI_AUTOSTART=1
TLAMATINI_AI_WARMUP_ON_START=0
TLAMATINI_AI_PROFILE=balanced
TLAMATINI_AI_ACCELERATOR=auto
TLAMATINI_AI_THREADS=0
TLAMATINI_AI_THREADS_BATCH=0
TLAMATINI_AI_BATCH_SIZE=0
TLAMATINI_AI_UBATCH_SIZE=0
TLAMATINI_AI_PARALLEL=1
TLAMATINI_AI_CACHE_RAM=512
TLAMATINI_AI_POLL=0
TLAMATINI_AI_WEBUI=0
TLAMATINI_AI_GPU_LAYERS=auto
TLAMATINI_AI_WARMUP_RETRIES=20
TLAMATINI_AI_WARMUP_SLEEP=1
TLAMATINI_AI_BACKEND=ollama
TLAMATINI_AI_RUNTIME_BIN=local_ai/runtime/bin/llama-server
TLAMATINI_PRIMARY_MODEL=gemma3:4b
TLAMATINI_LOCAL_LLM_MODEL=gemma3:4b
TLAMATINI_LOCAL_LLM_CONTEXT=3072
TLAMATINI_LOCAL_LLM_MAX_TOKENS=320
TLAMATINI_AI_BOOT_MODEL=gemma3:4b
TLAMATINI_AI_AUTO_PULL=1
TLAMATINI_ENABLE_MISTRAL=0
TLAMATINI_MODEL_GEMMA3_PATH=local_ai/models/gemma3/model.gguf
TLAMATINI_MODEL_MISTRAL_PATH=local_ai/models/mistral/model.gguf
TLAMATINI_RUNTIME_URL=
TLAMATINI_GEMMA3_URL=
TLAMATINI_MISTRAL_URL=https://huggingface.co/bartowski/Mistral-7B-Instruct-v0.3-GGUF/resolve/main/Mistral-7B-Instruct-v0.3-Q4_K_M.gguf?download=true
TLAMATINI_MAPS_CATALOG_URL=
OLLAMA_HOST=http://127.0.0.1:11436

# Arranque simple:
# python main.py
# python main.py --safe
# python main.py --fast
# python main.py --with-mistral
# python main.py --no-ai
#
# Si usas Ollama y falta el modelo principal, TLAMATINI intentará descargarlo
# automaticamente en el primer arranque cuando TLAMATINI_AI_AUTO_PULL=1.
