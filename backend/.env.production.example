APP_ENV=production
APP_VERSION=5.1.0
API_BASE_URL=https://api.tu-dominio-tlamatini.com
DATABASE_URL=postgresql+psycopg://usuario:password-segura@host:5432/tlamatini_backend

JWT_SECRET=reemplaza-por-un-secreto-largo-unico-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

LICENSE_SIGNING_ALGORITHM=RS256
LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREEMPLAZA_CON_TU_CLAVE_PRIVADA_RS256\n-----END PRIVATE KEY-----
LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREEMPLAZA_CON_TU_CLAVE_PUBLICA_RS256\n-----END PUBLIC KEY-----
LICENSE_SIGNING_SECRET=

PADDLE_API_KEY=reemplaza-con-tu-paddle-api-key
PADDLE_WEBHOOK_SECRET=reemplaza-con-tu-paddle-webhook-secret
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRODUCT_ID=pro_xxxxxxxxxxxxxxxxx
PADDLE_PRICE_ID=pri_xxxxxxxxxxxxxxxxx

ADMIN_API_KEY=reemplaza-con-una-admin-api-key-larga-y-unica
TRIAL_DAYS=7
OFFLINE_GRACE_DAYS=30
AUTO_CREATE_TABLES=false
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

FORCE_HTTPS=true
ALLOWED_HOSTS=api.tu-dominio-tlamatini.com
CORS_ALLOW_ORIGINS=https://app.tu-dominio-tlamatini.com
